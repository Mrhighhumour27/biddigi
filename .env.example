# Server-only variables. Copy into an ignored .env.local and use Node --env-file=.env.local.
SITE_ORIGIN=https://biddigi.io
NODE_ENV=production
ENQUIRY_TO=mrhighhumour@gmail.com
# Must be a sender on your verified Resend domain, e.g. Biddigi <enquiries@your-domain.example>
EMAIL_FROM=
RESEND_API_KEY=
PORT=4173
HOST=127.0.0.1
# Select for the real host: socket (direct client), trusted-header (verified proxy), or edge.
# Leaving production mode unset intentionally disables submission until topology is confirmed.
ENQUIRY_RATE_LIMIT_MODE=
# For trusted-header only: exact proxy socket addresses and a header that proxy OVERWRITES.
ENQUIRY_TRUSTED_PROXY_IPS=
ENQUIRY_CLIENT_IP_HEADER=
# For edge only: set true only after configuring/verifying the hosting edge's per-client limit.
ENQUIRY_EDGE_RATE_LIMIT_CONFIRMED=false
